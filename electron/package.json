{
  "name": "offlinechat-electron",
  "version": "1.0.0",
  "description": "OfflineChat - Offline AI Chat Application",
  "main": "main.js",
  "homepage": "https://github.com/anumhosen/offlinechat",
  "author": {
    "name": "Anum Hosen",
    "email": "anumhosen@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development electron .",
    "build": "electron-builder",
    "build:dir": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "11.3.0",
    "cheerio": "1.0.0",
    "cross-env": "7.0.3",
    "duckduckgo-search": "1.0.7",
    "mammoth": "1.8.0",
    "node-llama-cpp": "3.18.1",
    "pdf-parse": "1.1.1",
    "pdfjs-dist": "4.0.379"
  },
  "devDependencies": {
    "electron": "30.5.1",
    "electron-builder": "25.1.7",
    "electron-rebuild": "3.2.9"
  },
  "build": {
    "appId": "com.offlinechat.app",
    "productName": "OfflineChat",
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.js",
      "preload.js",
      "backend/**/*",
      "ipc/**/*",
      "dist/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/node-llama-cpp/**",
      "node_modules/pdfjs-dist/**"
    ],
    "icon": "assets/icon.png",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "desktop": {
        "Name": "OfflineChat",
        "Comment": "Offline AI Chat Application",
        "Categories": "Utility;",
        "Terminal": false
      }
    }
  }
}
